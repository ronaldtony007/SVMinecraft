{
	"schemaVersion": 1,
	"id": "startermod",
	"version": "${version}",
	"name": "Starter Mod",
	"description": "A beginner Fabric mod for Minecraft 26.2.",
	"authors": [
		"Your Name"
	],
	"contact": {
		"sources": "https://github.com/"
	},
	"license": "CC0-1.0",
	"icon": "assets/startermod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.startermod.StarterMod"
		],
		"client": [
			"com.example.startermod.client.StarterModClient"
		]
	},
	"mixins": [
		"startermod.mixins.json",
		{
			"config": "startermod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
